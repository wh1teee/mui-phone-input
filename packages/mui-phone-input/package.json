{
  "name": "@wh1teee/mui-phone-input",
  "version": "1.0.1",
  "description": "Accessible international phone input for React with independent MUI, Base UI and shadcn adapters.",
  "license": "MIT",
  "author": "Konstantsin Petrovskiy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wh1teee/mui-phone-input.git"
  },
  "homepage": "https://github.com/wh1teee/mui-phone-input#readme",
  "bugs": {
    "url": "https://github.com/wh1teee/mui-phone-input/discussions/new?category=q-a"
  },

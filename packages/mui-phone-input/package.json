{
  "name": "@wh1teee/mui-phone-input",
  "version": "0.1.0-next.7",
  "description": "Accessible, deeply customizable international phone input for React and Material UI.",
  "license": "MIT",
  "author": "Konstantsin Petrovskiy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wh1teee/mui-phone-input.git"
  },
  "homepage": "https://github.com/wh1teee/mui-phone-input#readme",
  "bugs": {
    "url": "https://github.com/wh1teee/mui-phone-input/discussions/new?category=q-a"
  },
  "type": "module",
  "sideEffects": [
    "./dist/flags.css"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./react-hook-form": {
      "types": "./dist/react-hook-form.d.ts",
      "import": "./dist/react-hook-form.js",
      "default": "./dist/react-hook-form.js"
    },
    "./zod": {
      "types": "./dist/zod.d.ts",
      "import": "./dist/zod.js",
      "default": "./dist/zod.js"
    },
    "./metadata/max": {
      "types": "./dist/metadata/max.d.ts",
      "import": "./dist/metadata/max.js",
      "default": "./dist/metadata/max.js"
    },
    "./metadata/min": {
      "types": "./dist/metadata/min.d.ts",
      "import": "./dist/metadata/min.js",
      "default": "./dist/metadata/min.js"
    },
    "./metadata/mobile": {
      "types": "./dist/metadata/mobile.d.ts",
      "import": "./dist/metadata/mobile.js",
      "default": "./dist/metadata/mobile.js"
    },
    "./metadata/custom": {
      "types": "./dist/metadata/custom.d.ts",
      "import": "./dist/metadata/custom.js",
      "default": "./dist/metadata/custom.js"
    },
    "./flags": {
      "types": "./dist/flags.d.ts",
      "import": "./dist/flags.js",
      "default": "./dist/flags.js"
    },
    "./flags.css": "./dist/flags.css",
    "./locales/be": {
      "types": "./dist/locales/be.d.ts",
      "import": "./dist/locales/be.js",
      "default": "./dist/locales/be.js"
    },
    "./locales/en": {
      "types": "./dist/locales/en.d.ts",
      "import": "./dist/locales/en.js",
      "default": "./dist/locales/en.js"
    },
    "./locales/ru": {
      "types": "./dist/locales/ru.d.ts",
      "import": "./dist/locales/ru.js",
      "default": "./dist/locales/ru.js"
    },
    "./package.json": "./package.json"
  },
  "browserslist": [
    "Chrome >= 117",
    "Edge >= 121",
    "Firefox >= 121",
    "Safari >= 17",
    "iOS >= 17"
  ],
  "dependencies": {
    "@maskito/core": "5.3.1",
    "@maskito/react": "5.3.1",
    "libphonenumber-js": "1.13.10",
    "tabbable": "6.5.0"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^9.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "react-hook-form": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next"
  },
  "scripts": {
    "build": "tsdown && node ../../scripts/build-flag-assets.mjs",
    "clean": "node ../../scripts/clean-package.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/material": "9.2.0",
    "country-flag-icons": "1.6.20",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.83.0",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "zod": "4.4.3"
  }
}

{
  "name": "@whiteee/mui-phone-input",
  "version": "0.0.0-development",
  "description": "Accessible, deeply customizable international phone input for React and Material UI.",
  "license": "MIT",
  "author": "Konstantsin Petrovskiy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wh1teee/mui-phone-input.git"
  },
  "homepage": "https://github.com/wh1teee/mui-phone-input#readme",
  "bugs": {
    "url": "https://github.com/wh1teee/mui-phone-input/discussions/new?category=q-a"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "browserslist": [
    "Chrome >= 117",
    "Edge >= 121",
    "Firefox >= 121",
    "Safari >= 17",
    "iOS >= 17"
  ],
  "dependencies": {
    "@maskito/core": "5.3.1",
    "@maskito/react": "5.3.1",
    "libphonenumber-js": "1.13.10",
    "tabbable": "6.5.0"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^9.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "react-hook-form": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "node ../../scripts/clean-package.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/material": "9.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.83.0",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "zod": "4.4.3"
  }
}

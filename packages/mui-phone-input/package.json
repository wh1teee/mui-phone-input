    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@base-ui/react": "1.8.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/material": "9.4.0",
    "@types/react": "19.3.0",
    "country-flag-icons": "1.6.20",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "zod": "4.6.4"
  }

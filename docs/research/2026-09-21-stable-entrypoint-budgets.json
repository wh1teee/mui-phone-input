{
  "schemaVersion": 1,
  "measurement": {
    "bundled": ["@maskito/core", "@maskito/react", "libphonenumber-js", "tabbable"],
    "external": [
      "@base-ui/react",
      "@emotion/react",
      "@emotion/styled",
      "@mui/material",
      "react",
      "react-dom",
      "react-hook-form",
      "zod"
    ],
    "minifier": "oxc",
    "note": "Limits measure the package-owned client closure including the selected phone metadata, but excluding renderer and form peers already owned by the consuming application."
  },
  "profiles": {
    "index": {
      "metadata": "max",
      "renderer": "mui",
      "gzipLimit": 98000,
      "brotliLimit": 82500
    },
    "headless": {
      "metadata": "max",
      "renderer": "headless",
      "gzipLimit": 85000,
      "brotliLimit": 72000
    },
    "base-ui": {
      "metadata": "max",
      "renderer": "base-ui",
      "gzipLimit": 90000,
      "brotliLimit": 76000
    },
    "shadcn": {
      "metadata": "max",
      "renderer": "base-ui",
      "gzipLimit": 90000,
      "brotliLimit": 76000
    },
    "react-hook-form": {
      "metadata": "max",
      "renderer": "mui-rhf",
      "gzipLimit": 98000,
      "brotliLimit": 82500
    },
    "base-ui/react-hook-form": {
      "metadata": "max",
      "renderer": "base-ui-rhf",
      "gzipLimit": 90000,
      "brotliLimit": 76000
    },
    "mui/min": {
      "metadata": "min",
      "renderer": "mui",
      "gzipLimit": 76000,
      "brotliLimit": 64000
    },
    "headless/min": {
      "metadata": "min",
      "renderer": "headless",
      "gzipLimit": 63500,
      "brotliLimit": 53500
    },
    "base-ui/min": {
      "metadata": "min",
      "renderer": "base-ui",
      "gzipLimit": 69000,
      "brotliLimit": 58000,
      "note": "1.3.0 used a 66,141-byte gzip limit for a 66,045-byte baseline. PR66 calibrates this profile to 69,000 gzip / 58,000 Brotli for private measured country-list windowing and lazy search metadata; see 2026-11-16-country-list-windowing.md. This does not change the separate 100 ms consuming-product requirement."
    },
    "shadcn/min": {
      "metadata": "min",
      "renderer": "base-ui",
      "gzipLimit": 69000,
      "brotliLimit": 58000,
      "note": "1.3.0 used a 66,141-byte gzip limit for a 66,045-byte baseline. PR66 calibrates this profile to 69,000 gzip / 58,000 Brotli for private measured country-list windowing and lazy search metadata; see 2026-11-16-country-list-windowing.md. This does not change the separate 100 ms consuming-product requirement."
    },
    "mui/min/react-hook-form": {
      "metadata": "min",
      "renderer": "mui-rhf",
      "gzipLimit": 76000,
      "brotliLimit": 64000
    },
    "base-ui/min/react-hook-form": {
      "metadata": "min",
      "renderer": "base-ui-rhf",
      "gzipLimit": 69000,
      "brotliLimit": 58000
    }
  }
}
